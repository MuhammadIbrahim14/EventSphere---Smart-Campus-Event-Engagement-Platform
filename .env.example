VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS OTP (template vars: to_email, to_name, otp)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
# Optional dedicated notify template (else OTP template is reused; message goes in {{otp}})
# VITE_EMAILJS_NOTIFY_TEMPLATE_ID=template_xxxxx

# Stripe Checkout (sandbox / test mode) — publishable key optional for redirect Checkout
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Google Maps (venue location picker — enable Maps JavaScript API + Places API + Geocoding API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Edge Function secrets (set via: supabase secrets set …) — NEVER put sk_ in Vite:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

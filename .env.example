VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL (station QR posters / deep links). Netlify production:
VITE_PUBLIC_APP_URL=https://eventsphere-sceep.netlify.app

# EmailJS — one service, two templates (never mix OTP + campus notify)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
# OTP template only (signup verify + forgot password). Vars: to_email, to_name, otp
VITE_EMAILJS_TEMPLATE_ID=your_otp_template_id
# Campus notify template (registration, waitlist, payment, reminders).
# Vars: to_email, to_name, subject, title, message — Subject field = {{subject}}
VITE_EMAILJS_NOTIFY_TEMPLATE_ID=your_notify_template_id

# Stripe Checkout (sandbox / test mode) — publishable key optional for redirect Checkout
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Google Maps (venue location picker — enable Maps JavaScript API + Places API + Geocoding API)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Edge Function secrets (set via: supabase secrets set …) — NEVER put sk_ in Vite:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
